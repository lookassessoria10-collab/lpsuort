{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "destination": "/especialidades/joelho", "permanent": false },
    { "source": "/especialidades", "destination": "/especialidades/joelho", "permanent": false }
  ],
  "headers": [
    {
      "source": "/especialidades/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ]
}
